{
  "permissions": {
    "allow": [
      "Bash(wrangler tail:*)",
      "Bash(wrangler whoami:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git remote -v:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git push origin claude/*)",
      "Bash(git push -u origin claude/*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr merge --auto --squash *)",
      "Bash(gh pr comment:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(curl -s https://api.github.com/*)",
      "Bash(curl -s https://kokemusu.shiraoka.workers.dev/*)",
      "WebFetch(domain:kokemusu.shiraoka.workers.dev)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:docs.mcp.cloudflare.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:hono.dev)",
      "WebFetch(domain:orm.drizzle.team)",
      "WebFetch(domain:vite.dev)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:developer.chrome.com)",
      "WebFetch(domain:web.dev)"
    ],
    "deny": [
      "Bash(git push * --force*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push *main)",
      "Bash(git push *main *)",
      "Bash(git push * --delete *)",
      "Bash(gh auth *)",
      "Bash(gh api *)",
      "Bash(npx skills update*)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "skillOverrides": {
    "sandboxed-agent-git-relay": "name-only",
    "cloudflare-cron-to-discord": "name-only",
    "cloudflare-d1-weekly-backup-via-pr": "name-only",
    "cloudflare-api-token-permissions": "name-only",
    "cloudflare-workers-host-synthetic-check": "name-only",
    "cloudflare-workflows-for-long-tasks": "name-only",
    "cloudflare-workers-space-membership-invite": "name-only",
    "cloudflare-r2-private-image-upload": "name-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-pr-merge.sh",
            "args": [],
            "timeout": 30,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-push-delete.sh",
            "args": [],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
