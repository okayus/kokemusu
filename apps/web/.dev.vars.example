# Copy to .dev.vars (gitignored) for local dev. Keys only here; never commit values.
#
# WebAuthn relying party for local dev. Overrides the production values pinned in
# wrangler.jsonc `vars` — .dev.vars never reaches production.
# ORIGIN must be the URL the BROWSER opens. In the sandbox that is the host-mapped
# port 5273 (Vite listens on 5173 inside the container) — with 5173 here, the CSRF
# Origin check 403s every POST and WebAuthn verify fails with challenge_mismatch.
RP_ID=localhost
ORIGIN=http://localhost:5273

# Signs the session JWT and the WebAuthn challenge cookie. 32+ chars required
# (shorter values are treated as unset = every auth route fails closed).
# Generate: openssl rand -hex 32. Production: `wrangler secret put SESSION_SECRET`.
SESSION_SECRET=

# Opens `POST /api/auth/register/*`. Unset = 403 registration_closed (fail closed).
# Any string works in dev. Production: set via `wrangler secret put`, register both
# devices, then `wrangler secret delete INITIAL_REGISTRATION_TOKEN` to close the door.
INITIAL_REGISTRATION_TOKEN=

# Set to 1 ONLY for `vite dev`: relaxes the CSP so Vite's inline HMR preamble can
# run (script-src 'unsafe-inline' + ws: for the HMR websocket). Never in production;
# leave unset for e2e against the build artifact so e2e asserts the real CSP.
DEV_CSP=1

# Pepper for API tokens: api_token.token_hash = sha256(token + PAT_PEPPER).
# 32+ chars required (shorter/unset = minting answers 503 and Bearer auth matches
# nothing — fail closed, so no token can ever be minted against a missing pepper).
# Generate: openssl rand -hex 32. Use a value DIFFERENT from production.
# Production: `wrangler secret put PAT_PEPPER` BEFORE the first token is minted,
# then never change it — a new value kills every existing PAT at once.
PAT_PEPPER=

# AES-256-GCM key for body/title encryption at rest (ADR-0001). Standard base64,
# exactly 32 bytes — generate: openssl rand -base64 32. Anything else counts as
# unset (posts routes fail closed once PR4 wires them). Use a value DIFFERENT
# from production. Production (host): run openssl, save the value to 1Password
# FIRST, then paste it into the `wrangler secret put BODY_KEY` prompt — never
# pipe it in (the value would scroll past unseen; losing it = every stored body
# is unrecoverable).
BODY_KEY=