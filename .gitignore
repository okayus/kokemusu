# dependencies / build artifacts
node_modules/
dist/
build/
.wrangler/
*.log
# Playwright artifacts (traces / screenshots of failed e2e runs)
test-results/
playwright-report/

# env / secrets (never commit)
.dev.vars
.env
.env.*
!.dev.vars.example

# local-only dev sandbox overrides (host-specific paths, e.g. skills mount)
docker-compose.override.yml
# 1Password secret REFERENCE for the sandbox GitHub token (host-specific vault/item).
# Never a value — but still per-host. Template: .docker/sandbox.env.example
.docker/sandbox.env

# Claude Code per-user overrides (project defaults live in .claude/settings.json
# and .mcp.json which ARE committed).
.claude/settings.local.json

# OS / editor
.DS_Store
*.swp

# generated by `wrangler types` (pnpm check regenerates it)
worker-configuration.d.ts
# pnpm store lands next to the bind-mounted workspace inside the sandbox
.pnpm-store/
