# Sandbox GitHub token — resolved by `op run` on the host inside ./up.sh.
# This file holds a 1Password secret REFERENCE (op://...), never a value.
# Copy to .docker/sandbox.env (gitignored) and point it at your vault/item:
#   op item create --category "API Credential" --vault "<vault>" \
#     --title "github-pat-kokemusu-sandbox" 'credential=<token>' 'expires=<YYYY-MM-DD>'
# Token scope: okayus/kokemusu only · Contents + Pull requests · no Workflows · 90 days.
GH_TOKEN="op://<vault>/github-pat-kokemusu-sandbox/credential"
